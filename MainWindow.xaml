<Window x:Class="AnnoCfgComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:local="clr-namespace:AnnoCfgComposer"
        Title="Anno Cfg Composer" Icon="app.ico" Width="1500" Height="900" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        Loaded="OnLoaded" Closed="OnClosed" PreviewKeyDown="OnWindowKeyDown">
    <DockPanel>

        <!-- ============================================================ Menu -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource WindowBg}" Padding="4,2">
            <MenuItem x:Name="FileMenu">
                <MenuItem x:Name="GameMenuItem" Click="OnPickGame"/>
                <MenuItem x:Name="OpenMenuItem" Click="OnOpenDisk" InputGestureText="Ctrl+O"/>
                <MenuItem x:Name="AddModMenuItem" Click="OnAddModFolder"/>
                <Separator/>
                <MenuItem x:Name="ExtractMenuItem" Click="OnExtract" InputGestureText="Ctrl+E" IsEnabled="False"/>
                <MenuItem x:Name="GltfMenuItem" Click="OnExportGltf" InputGestureText="Ctrl+G" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="ExitMenuItem" Click="OnExit"/>
            </MenuItem>
            <MenuItem x:Name="ViewMenu">
                <MenuItem x:Name="MirrorMenuItem" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=MirrorToggle, Mode=TwoWay}" Click="OnViewOptionChanged"/>
                <MenuItem x:Name="TextureMenuItem" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=TextureToggle, Mode=TwoWay}" Click="OnViewOptionChanged"/>
                <MenuItem x:Name="GridMenuItem" IsCheckable="True" IsChecked="{Binding IsChecked, ElementName=GridToggle, Mode=TwoWay}" Click="OnGridChanged"/>
                <MenuItem x:Name="AxesMenuItem" IsCheckable="True" IsChecked="True" Click="OnAxesChanged"/>
                <Separator/>
                <MenuItem x:Name="GpuMenu"/>
                <Separator/>
                <MenuItem x:Name="FitMenuItem" Click="OnZoomExtents" InputGestureText="F"/>
            </MenuItem>
            <MenuItem x:Name="LangMenu">
                <MenuItem Header="English" Tag="0" IsCheckable="True" Click="OnLanguageMenu"/>
                <MenuItem Header="Deutsch" Tag="1" IsCheckable="True" Click="OnLanguageMenu"/>
                <MenuItem Header="한국어" Tag="2" IsCheckable="True" Click="OnLanguageMenu"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenu">
                <MenuItem x:Name="LogsMenuItem" Click="OnOpenLogs"/>
                <Separator/>
                <MenuItem x:Name="AboutMenuItem" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ============================================================ Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Background="{StaticResource WindowBg}" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenButton" Style="{StaticResource ToolButton}" Click="OnOpenDisk">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;"/>
                        <TextBlock x:Name="OpenLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExtractButton" Style="{StaticResource ToolButton}" Click="OnExtract" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;"/>
                        <TextBlock x:Name="ExtractLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="GltfButton" Style="{StaticResource ToolButton}" Click="OnExportGltf" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xF158;"/>
                        <TextBlock x:Name="GltfLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolSeparator}"/>
                <ToggleButton x:Name="MirrorToggle" Style="{StaticResource ToolButton}" IsChecked="True" Click="OnViewOptionChanged">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;"/>
                        <TextBlock x:Name="MirrorLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TextureToggle" Style="{StaticResource ToolButton}" IsChecked="True" Click="OnViewOptionChanged">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;"/>
                        <TextBlock x:Name="TextureLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="GridToggle" Style="{StaticResource ToolButton}" IsChecked="True" Click="OnGridChanged">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80A;"/>
                        <TextBlock x:Name="GridLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <Border Style="{StaticResource ToolSeparator}"/>
                <Button x:Name="FitButton" Style="{StaticResource ToolButton}" Click="OnZoomExtents">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9A6;"/>
                        <TextBlock x:Name="FitLabel" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================================================ Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource PanelBg}" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="GameStatusText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock x:Name="GpuStatusText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,18,0"/>
                <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================ Left: game files -->
            <DockPanel Grid.Column="0" Background="{StaticResource PanelBg}">
                <TextBlock x:Name="FilesHeader" DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"/>
                <Border DockPanel.Dock="Top" Margin="10,0,10,4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Muted}" Margin="9,0,0,0" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="SearchPlaceholder" Foreground="{StaticResource Muted}" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" Background="Transparent" BorderThickness="0" Padding="28,5,6,5" VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Margin="12,2,12,6" Foreground="{StaticResource Muted}" FontSize="11"/>
                <!-- Hint for dropping mod folders / cfgs -->
                <Border DockPanel.Dock="Bottom" Margin="10,4,10,10" Padding="8,7" CornerRadius="5"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource CardBg}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="DropHint" Margin="7,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TreeView x:Name="CfgTree" SelectedItemChanged="OnTreeSelected" BorderThickness="0" Background="Transparent" Padding="4,0"
                          AllowDrop="True" DragEnter="OnTreeDragOver" DragOver="OnTreeDragOver" DragLeave="OnTreeDragLeave" Drop="OnTreeDrop"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="2,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}" Background="Transparent">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding Path=(local:Loc.CopyPathText)}" Click="OnCopyTreePath"/>
                                        <MenuItem Header="{Binding Path=(local:Loc.RemoveModText)}" Click="OnRemoveMod" Visibility="{Binding ModRootVisibility}"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- ============================================================ Center: 3D -->
            <Grid Grid.Column="2">
                <!-- Direct3D 11 (HelixToolkit SharpDX). EffectsManager is set in code -->
                <hx:Viewport3DX x:Name="View" BackgroundColor="#2B2D31" ModelUpDirection="0,1,0"
                                ShowCoordinateSystem="True" ShowViewCube="True" ViewCubeVerticalPosition="0.8"
                                CameraRotationMode="Turntable" MSAA="Four"
                                ZoomExtentsWhenLoaded="False" IsShadowMappingEnabled="False">
                    <hx:Viewport3DX.Camera>
                        <hx:PerspectiveCamera Position="14,11,14" LookDirection="-14,-11,-14" UpDirection="0,1,0"
                                              FieldOfView="45" NearPlaneDistance="0.05" FarPlaneDistance="5000"/>
                    </hx:Viewport3DX.Camera>
                    <hx:AmbientLight3D Color="#6A6A6A"/>
                    <hx:DirectionalLight3D Color="#D0D0D0" Direction="-0.5,-1,-0.35"/>
                    <hx:DirectionalLight3D Color="#505050" Direction="0.6,-0.3,0.7"/>
                    <!-- Ground grid: 1 cell = 1, darker line every 10 cells (line geometry is built in code) -->
                    <hx:GroupModel3D x:Name="GridVisual">
                        <hx:LineGeometryModel3D x:Name="GridMinor" Color="#3CFFFFFF" Thickness="0.6"/>
                        <hx:LineGeometryModel3D x:Name="GridMajor" Color="#80FFFFFF" Thickness="1.0"/>
                    </hx:GroupModel3D>
                    <hx:GroupModel3D x:Name="SceneGroup"/>
                </hx:Viewport3DX>

                <StackPanel x:Name="ViewHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xF158;" FontSize="40" Foreground="#666" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ViewHintText" Foreground="#AAA" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#99202226" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                        <TextBlock x:Name="LoadingText" Foreground="#DDD" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="MouseHint" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8"
                           Foreground="#8A8F98" FontSize="11" IsHitTestVisible="False"/>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- ============================================================ Right: details -->
            <DockPanel Grid.Column="4" Background="{StaticResource PanelBg}">
                <TextBlock x:Name="InfoHeader" DockPanel.Dock="Top" Style="{StaticResource PanelHeader}"/>

                <TextBlock x:Name="InfoEmpty" DockPanel.Dock="Top" Margin="12,20" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

                <Grid x:Name="InfoPanel" Visibility="Collapsed" Margin="9,0,9,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="3,0,3,6">
                        <TextBlock x:Name="InfoName" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0"/>
                        <TextBox x:Name="InfoPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                 Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="3,4,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="InfoSource" Foreground="{StaticResource Muted}" FontSize="11" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock x:Name="StatCfg" Style="{StaticResource CardValue}"/><TextBlock x:Name="StatCfgLabel" Style="{StaticResource CardLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock x:Name="StatModels" Style="{StaticResource CardValue}"/><TextBlock x:Name="StatModelsLabel" Style="{StaticResource CardLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock x:Name="StatTris" Style="{StaticResource CardValue}"/><TextBlock x:Name="StatTrisLabel" Style="{StaticResource CardLabel}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel><TextBlock x:Name="StatTime" Style="{StaticResource CardValue}"/><TextBlock x:Name="StatTimeLabel" Style="{StaticResource CardLabel}"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border x:Name="WarnBox" Visibility="Collapsed" Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnLine}"
                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="3,6,3,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource WarnText}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock x:Name="WarnText" Foreground="{StaticResource WarnText}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="DecalNote" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TabControl x:Name="InfoTabs" Grid.Row="1" Margin="3,4,3,0">
                        <TabItem x:Name="PartsTab">
                            <TreeView x:Name="PartsTree" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}" Background="Transparent">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding Path=(local:Loc.CopyPathText)}" Click="OnCopyPartPath"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </TabItem>
                        <TabItem x:Name="IssuesTab">
                            <TextBox x:Name="IssuesBox" IsReadOnly="True" BorderThickness="0" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
